# Copy to .env (git-ignored) and fill in. Used by Scripts/resign-to-watch.sh.

# Required: your watch's UDID or CoreDevice identifier.
# Find it with: xcrun devicectl list devices  (use the "physical" watch, not a simulator)
SUNTIMES_WATCH_ID=

# Optional: Apple Developer team ID. Auto-detected from the "Apple Development"
# certificate in your keychain; set it only if you have more than one team.
# SUNTIMES_TEAM_ID=

# Optional: minimum hours between re-installs (default 20).
# SUNTIMES_MIN_INTERVAL_HOURS=20
